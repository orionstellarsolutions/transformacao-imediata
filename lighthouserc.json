{
  "ci": {
    "collect": {
      "numberOfRuns": 1,
      "url": [
        "http://localhost:3000/?ci=1"
      ],
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new --disable-gpu --disable-dev-shm-usage",
        "skipAudits": [
          "uses-http2"
        ],
        "maxWaitForFcp": 30000,
        "maxWaitForLoad": 45000
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    },
    "assert": {
      "budgetsFile": "./lighthouse-budget.json"
    }
  }
}
